# Vikunja API Configuration (REQUIRED)
VIKUNJA_BASE_URL=https://vikunja-instance.com/api/v1
VIKUNJA_API_TOKEN=your_api_token_here

# Timezone Configuration (REQUIRED)
TIMEZONE=America/Denver

# Email Configuration (REQUIRED for email notifications)
EMAIL_SENDER=vikunja-notifications@example.com
EMAIL_SUBJECT=Your Vikunja Task Summary
EMAIL_TEMPLATE=default.html  # Template file in email_templates directory

# SMTP Configuration (REQUIRED for email notifications)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# SMTP Security (choose one based on your email provider)
USE_TLS=true  # For most modern SMTP servers (e.g., Gmail, Outlook)
USE_SSL=false # For legacy SSL connections

# Mattermost Webhook Configuration (REQUIRED for Mattermost notifications)
MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/hooks/your-webhook-id
MATTERMOST_USERNAME=Vikunja Tasks  # Optional: Custom bot name
MATTERMOST_ICON_URL=https://example.com/icon.png  # Optional: Custom bot icon

# Logging Configuration (optional)
# LOG_FILE=/path/to/vikunja_tasks.log  # Uncomment to enable logging to a file 
